{
  "title": "My Keymaps",
  "rules": [
    {
      "description": "Tab即時英数、ダブルタップで日本語切替、Tab+Q=ESC",
      "manipulators": [
        {
          "description": "Tab+Q = ESC",
          "type": "basic",
          "from": { "key_code": "q", "modifiers": { "optional": ["any"] } },
          "conditions": [
            { "type": "variable_if", "name": "tab_held", "value": 1 },
            { "type": "variable_unless", "name": "f13_pressed", "value": 1 }
          ],
          "to": [{ "key_code": "escape" }]
        },
        {
          "description": "Tab+W = Spotlight検索",
          "type": "basic",
          "from": { "key_code": "w", "modifiers": { "optional": ["any"] } },
          "conditions": [
            { "type": "variable_if", "name": "tab_held", "value": 1 },
            { "type": "variable_unless", "name": "f13_pressed", "value": 1 }
          ],
          "to": [{ "key_code": "spacebar", "modifiers": ["left_command"] }]
        },
        {
          "description": "【2回目】300ms以内に再度押されたらかなキーで上書き",
          "type": "basic",
          "from": { "key_code": "japanese_eisuu", "modifiers": { "optional": ["any"] } },
          "conditions": [
            { "type": "variable_if", "name": "tab_tapped_once", "value": 1 }
          ],
          "to": [
            { "set_variable": { "name": "tab_tapped_once", "value": 0 } },
            { "key_code": "japanese_kana" }
          ]
        },
        {
          "description": "【1回目】即座に英数を送り、ダブルタップ検出用の変数をセット",
          "type": "basic",
          "from": { "key_code": "japanese_eisuu", "modifiers": { "optional": ["any"] } },
          "to": [
            { "key_code": "japanese_eisuu" },
            { "set_variable": { "name": "tab_tapped_once", "value": 1 } },
            { "set_variable": { "name": "tab_held", "value": 1 } }
          ],
          "to_after_key_up": [
            { "set_variable": { "name": "tab_held", "value": 0 } }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              { "set_variable": { "name": "tab_tapped_once", "value": 0 } }
            ],
            "to_if_canceled": [
              { "set_variable": { "name": "tab_tapped_once", "value": 0 } }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 300
          }
        }
      ]
    },
    {
      "description": "F13レイヤー",
      "manipulators": [
        {
          "description": "F13を押している間、変数 f13_pressed を 1 にする",
          "type": "basic",
          "from": { "key_code": "f13", "modifiers": { "optional": ["any"] } },
          "to": [{ "set_variable": { "name": "f13_pressed", "value": 1 } }],
          "to_after_key_up": [
            { "set_variable": { "name": "f13_pressed", "value": 0 } }
          ]
        },
        {
          "description": "F13+Cmd = Mission Control",
          "type": "basic",
          "from": { "key_code": "left_command", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "mission_control" }]
        },
        {
          "description": "F13+1 = ウィンドウを最大化(Dock・タスクバー除く)",
          "type": "basic",
          "from": { "key_code": "1", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [
            {
              "shell_command": "~/.config/karabiner/assets/scripts/resize_full.sh"
            }
          ]
        },
        {
          "description": "F13+H = 左矢印",
          "type": "basic",
          "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "description": "F13+J = 下矢印",
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "description": "F13+K = 上矢印",
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "description": "F13+L = 右矢印",
          "type": "basic",
          "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "description": "F13+3 = Cmd+↑ (ドキュメント先頭)",
          "type": "basic",
          "from": { "key_code": "3", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "up_arrow", "modifiers": ["left_command"] }]
        },
        {
          "description": "F13+4 = Cmd+↓ (ドキュメント末尾)",
          "type": "basic",
          "from": { "key_code": "4", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "down_arrow", "modifiers": ["left_command"] }]
        },
        {
          "description": "F13+7 = Home (行頭)",
          "type": "basic",
          "from": { "key_code": "7", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "home" }]
        },
        {
          "description": "F13+8 = End (行末)",
          "type": "basic",
          "from": { "key_code": "8", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "end" }]
        },
        {
          "description": "F13+Backspace = Delete (Forward Delete)",
          "type": "basic",
          "from": { "key_code": "delete_or_backspace", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "delete_forward" }]
        },
        {
          "description": "F13+Q = Cmd+[ (ブラウザ戻る)",
          "type": "basic",
          "from": { "key_code": "q", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "close_bracket", "modifiers": ["left_command"] }]
        },
        {
          "description": "F13+W = Cmd+] (ブラウザ進む)",
          "type": "basic",
          "from": { "key_code": "w", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "backslash", "modifiers": ["left_command"] }]
        },
        {
          "description": "F13+E = Cmd+W (タブを閉じる)",
          "type": "basic",
          "from": { "key_code": "e", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "w", "modifiers": ["left_command"] }]
        },
        {
          "description": "F13+A = Ctrl+Shift+Tab (前のタブ)",
          "type": "basic",
          "from": { "key_code": "a", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "tab", "modifiers": ["left_control", "left_shift"] }]
        },
        {
          "description": "F13+S = Ctrl+Tab (次のタブ)",
          "type": "basic",
          "from": { "key_code": "s", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "tab", "modifiers": ["left_control"] }]
        },
        {
          "description": "F13+D = Cmd+Shift+T (閉じたタブを再び開く)",
          "type": "basic",
          "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "t", "modifiers": ["left_command", "left_shift"] }]
        },
        {
          "description": "F13+F = Cmd+R (更新)",
          "type": "basic",
          "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "r", "modifiers": ["left_command"] }]
        },
        {
          "description": "F13+G = Option+Shift+G",
          "type": "basic",
          "from": { "key_code": "g", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "g", "modifiers": ["left_option", "left_shift"] }]
        },
        {
          "description": "F13+Z = Option+Shift+Z",
          "type": "basic",
          "from": { "key_code": "z", "modifiers": { "optional": ["any"] } },
          "conditions": [{ "type": "variable_if", "name": "f13_pressed", "value": 1 }],
          "to": [{ "key_code": "z", "modifiers": ["left_option", "left_shift"] }]
        }
      ]
    },
    {
      "description": "Cmd+C ダブルタップで行選択コピー",
      "manipulators": [
        {
          "description": "【2回目】500ms以内ならば行選択してコピー",
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": { "mandatory": ["left_command"] }
          },
          "conditions": [{ "type": "variable_if", "name": "cmd_c_tapped", "value": 1 }],
          "to": [
            { "set_variable": { "name": "cmd_c_tapped", "value": 0 } },
            { "key_code": "right_arrow", "modifiers": ["left_command"] },
            { "key_code": "left_arrow", "modifiers": ["left_command", "left_shift"] },
            { "key_code": "c", "modifiers": ["left_command"] }
          ]
        },
        {
          "description": "【1回目】即座にコピーし、ダブルタップ検出用変数をセット",
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": { "mandatory": ["left_command"] }
          },
          "to": [
            { "key_code": "c", "modifiers": ["left_command"] },
            { "set_variable": { "name": "cmd_c_tapped", "value": 1 } }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              { "set_variable": { "name": "cmd_c_tapped", "value": 0 } }
            ],
            "to_if_canceled": [
              { "set_variable": { "name": "cmd_c_tapped", "value": 0 } }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 500
          }
        }
      ]
    },
    {
      "description": "Left Control(→Command)+I = F7(カタカナ変換)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": { "mandatory": ["left_command"], "optional": ["any"] }
          },
          "to": [{ "key_code": "f7" }]
        }
      ]
    }
  ]
}
